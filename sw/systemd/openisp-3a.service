# 3A daemon of the openISP hardware ISP.  Edit the tuning file path, then
#   sudo systemctl enable --now openisp-3a
# Live tuning from the PC (the socket is only reachable through ssh):
#   ssh -N -L 5555:/run/openisp/live.sock ubuntu@kv260 &
#   python -m isptune live --port 5555 state
[Unit]
Description=openISP 3A daemon (AE / AWB / AF)
After=multi-user.target

[Service]
RuntimeDirectory=openisp
ExecStart=/usr/local/bin/openisp run /etc/openisp/tuning.json --listen unix:/run/openisp/live.sock
Restart=on-failure
RestartSec=2

[Install]
WantedBy=multi-user.target
